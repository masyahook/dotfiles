# Copy this file to ~/.env and fill in real values.
# ~/.env is sourced by zsh/.zshrc and is gitignored — never commit real secrets.

# GitHub
export GITHUBTOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export GITHUBEMAIL="you@example.com"
export GITHUBUSERNAME="your-username"
export GITHUB_PERSONAL_ACCESS_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Weights & Biases
export WANDB_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
